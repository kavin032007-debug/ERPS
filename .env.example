# Database Configuration (Production: PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/erps_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# First Super Admin Configuration (for initial setup)
SUPER_ADMIN_EMAIL=admin@institution.edu
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword123!
SUPER_ADMIN_NAME=Controller of Examinations

# MFA Configuration (true in production, false allowed in dev/demo)
APP_MFA_ENABLED=false

# Institution Default Settings (Configurable in UI)
INSTITUTION_NAME=Your Institution Name
INSTITUTION_ADDRESS=Campus Road, Knowledge City, State - 600001
UNIVERSITY_NAME=Affiliating State University
